---
import type { AstroStyleAttributes } from 'astro'

interface Props {
  class?: string
  gap?: number
}

const { class: className = '', gap = 1, ...rest } = Astro.props
---
<div class={`row ${className}`} style={`gap: ${gap}rem`} {...rest}>
  <slot />
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
  }
</style>
