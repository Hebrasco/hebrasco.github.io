---
import { CONFIG, ROUTES } from 'data'
---
<nav class="nav">
  <div class="nav-inner">
    <div class="navbar-brand-container">
      <a class="brand" href={ROUTES.home}>{CONFIG.profile.name}</a>
      <button
        class="menu-icon"
        id="navbar-toggle"
        type="button"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span></span>
        <span></span>
      </button>
    </div>
    <div class="navbar-items-collapse" id="navbar-items">
      <div class="navbar-items-container">
        <a class="nav-item" href={ROUTES.aboutMe}>About Me</a>
        <a class="nav-item" href={ROUTES.projects}>Projects</a>
        <a class="nav-item" href={ROUTES.contact}>Contact</a>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 1000;
    background: var(--glass-background);
    border-bottom: 1px solid var(--glass-border);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--content-max-width);
    height: 3rem;
    padding: 0 var(--content-padding);
    margin: 0 auto;
  }

  .brand {
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    color: var(--primary-text-color);
    letter-spacing: var(--letter-spacing-ui);
    text-decoration: none;
  }

  .menu-icon {
    --navbar-button-hitbox: -15px;
    --menu-icon-size: 1rem;
    all: unset;
    position: relative;
    display: none;
    width: var(--menu-icon-size);
    height: var(--menu-icon-size);
    cursor: pointer;
  }

  .menu-icon::after {
    position: absolute;
    top: var(--navbar-button-hitbox);
    right: var(--navbar-button-hitbox);
    bottom: var(--navbar-button-hitbox);
    left: var(--navbar-button-hitbox);
    content: "";
  }

  .menu-icon span {
    --menu-icon-span-size: 1.5px;
    --menu-icon-animation-duration-top: 150ms;
    --menu-icon-animation-duration-transform: 250ms;
    position: absolute;
    display: block;
    width: 100%;
    height: var(--menu-icon-span-size);
    background-color: var(--primary-text-color);
    border-radius: 3px;
    transform: rotate(0deg);
    transition:
      top var(--menu-icon-animation-duration-top) ease-in-out
        var(--menu-icon-animation-duration-transform),
      transform var(--menu-icon-animation-duration-transform) ease-in-out;
  }

  .menu-icon.open > span {
    transition:
      top var(--menu-icon-animation-duration-top) ease-in-out,
      transform var(--menu-icon-animation-duration-transform) ease-in-out
        var(--menu-icon-animation-duration-top);
  }

  .menu-icon > span:nth-child(1) { top: 0.25rem; }
  .menu-icon > span:nth-child(2) {
    top: calc(var(--menu-icon-size) - 0.25rem - var(--menu-icon-span-size));
  }

  .menu-icon.open > span:nth-child(1),
  .menu-icon.open > span:nth-child(2) { top: 50%; }
  .menu-icon.open > span:nth-child(1) { transform: rotate(-45deg); }
  .menu-icon.open > span:nth-child(2) { transform: rotate(45deg); }

  .nav-inner {
    display: flex;
    align-items: center;
    padding: 0.5rem 1rem;
  }

  .navbar-brand-container {
    display: flex;
    align-items: center;
    height: 3rem;
  }

  .navbar-items-container {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }

  .navbar-items-collapse:not(.expanded) {
    display: flex;
  }

  .nav-item {
    font-size: var(--font-size-extra-small);
    color: var(--muted-text-color);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .nav-item:hover {
    color: var(--primary-text-color);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .nav-inner {
      flex-wrap: wrap;
      align-items: stretch;
      height: auto;
      padding: 0 var(--content-padding-mobile);
    }

    .menu-icon {
      display: block;
    }

    .nav-inner {
      flex-direction: column;
      align-items: stretch;
    }

    .navbar-brand-container {
      justify-content: space-between;
    }

    .nav-item {
      width: 100%;
      padding: 10px 0;
      font-size: var(--font-size-medium);
    }

    .navbar-items-collapse:not(.expanded) {
      display: none;
    }

    .navbar-items-collapsing {
      height: 0;
      overflow: hidden;
      transition: height 350ms ease;
    }

    .navbar-items-container {
      flex-direction: column;
      gap: 0;
      align-items: flex-start;
      width: 100%;
      padding: 12px 0 16px;
      border-top: 1px solid var(--divider-color);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-items-collapsing,
    .nav-item,
    .menu-icon {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('navbar-toggle')
  const container = document.getElementById('navbar-items')

  if (btn && container) {
    const animationTimeout = (parseFloat(getComputedStyle(container).transitionDuration) || 0.35) * 1000 + 5

      function handleClose(): void {
        if (!container) return

        container.style.height = `${container.scrollHeight}px`

        container.classList.remove('navbar-items-collapse')
        container.classList.remove('expanded')

        container.classList.add('navbar-items-collapsing')

        container.style.height = ''

        setTimeout(() => {
          container.classList.remove('navbar-items-collapsing')
          container.classList.add('navbar-items-collapse')
          container.classList.remove('expanded')
        }, animationTimeout)
      }

      function handleOpen(): void {
        if (!container) return

        container.classList.remove('navbar-items-collapse')
        container.classList.add('navbar-items-collapsing')

        setTimeout(() => {
          container.classList.remove('navbar-items-collapsing')
          container.classList.add('navbar-items-collapse')
          container.classList.add('expanded')
        }, animationTimeout)

        container.style.height = `${container.scrollHeight}px`
      }

      btn.addEventListener('click', () => {
        const isOpen = btn.classList.contains('open')

        if (isOpen) {
          handleClose()
        } else {
          handleOpen()
        }

        btn.classList.toggle('open')
        btn.setAttribute('aria-expanded', String(!isOpen))
      })

      document.querySelectorAll('#navbar-items a').forEach((link) => {
        link.addEventListener('click', () => {
          if (btn.classList.contains('open')) btn.click()
        })
      })

      document.addEventListener('click', (event) => {
        const node = event.target as Node

        const hasClickedOutside = btn.classList.contains('open') && !btn.contains(node) && !container.contains(node)

        if (!hasClickedOutside) return

        handleClose()
        btn.classList.remove('open')
      })
  }
</script>
