---
import { CONFIG, ROUTES } from 'data'
---
<nav class="navbar-glass shadow">
  <div class="navbar-container">
    <div class="navbar-brand-container">
      <a class="nav-item me-5" href={ROUTES.home}>{CONFIG.profile.name}</a>
      <button
        class="menu-icon"
        id="navbar-toggle"
        type="button"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span></span>
        <span></span>
      </button>
    </div>

    <div class="navbar-items-collapse" id="navbar-items">
      <div class="navbar-items-container gap-4">
        <a class="nav-item" href={ROUTES.aboutMe}>About Me</a>
        <a class="nav-item" href={ROUTES.projects}>Projects</a>
        <a class="nav-item" href={ROUTES.contact}>Contact</a>
      </div>
    </div>
  </div>
</nav>

<style>
  .menu-icon {
    --navbar-button-hitbox: -15px;
    --menu-icon-size: 1rem;
    all: unset;
    position: relative;
    height: var(--menu-icon-size);
    width: var(--menu-icon-size);
    cursor: pointer;
    display: none;
  }
  .menu-icon::after {
    content: "";
    left: var(--navbar-button-hitbox);
    right: var(--navbar-button-hitbox);
    bottom: var(--navbar-button-hitbox);
    top: var(--navbar-button-hitbox);
    position: absolute;
  }
  .menu-icon span {
    --menu-icon-span-size: 2px;
    --menu-icon-animation-duration-top: 150ms;
    --menu-icon-animation-duration-transform: 250ms;
    display: block;
    position: absolute;
    height: var(--menu-icon-span-size);
    width: 100%;
    border-radius: 3px;
    transform: rotate(0deg);
    transition:
      top var(--menu-icon-animation-duration-top) ease-in-out
        var(--menu-icon-animation-duration-transform),
      transform var(--menu-icon-animation-duration-transform) ease-in-out;
    background-color: var(--primary-text-color);
  }
  .menu-icon.open > span {
    transition:
      top var(--menu-icon-animation-duration-top) ease-in-out,
      transform var(--menu-icon-animation-duration-transform) ease-in-out
        var(--menu-icon-animation-duration-top);
  }
  .menu-icon > span:nth-child(1) { top: 0.25rem; }
  .menu-icon > span:nth-child(2) {
    top: calc(var(--menu-icon-size) - 0.25rem - var(--menu-icon-span-size));
  }
  .menu-icon.open > span:nth-child(1),
  .menu-icon.open > span:nth-child(2) { top: 50%; }
  .menu-icon.open > span:nth-child(1) { transform: rotate(-45deg); }
  .menu-icon.open > span:nth-child(2) { transform: rotate(45deg); }

  .navbar-glass {
    background-color: var(--glassBackground);
    backdrop-filter: blur(var(--glassBlur));
    width: fit-content;
    margin: 12px;
    border-radius: 30px;
    border-width: 2px;
    border-style: solid;
    border-color: var(--glassBorder);
    left: unset;
    position: fixed;
    top: 0;
    right: 0;
    z-index: 1000;
  }

  .navbar-glass-mobile {
    border-radius: 27px;
  }

  .navbar-container {
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
  }

  .navbar-brand-container {
    display: flex;
    align-items: center;
  }
  .navbar-brand-container > a {
    font-size: 1.25em;
  }

  .navbar-items-container {
    display: flex;
    align-items: center;
  }

  .navbar-items-collapse:not(.expanded) {
    display: flex;
  }
  @media (max-width: 575px) {
    .navbar-glass {
      border-radius: 27px;
    }
    .menu-icon {
      display: block;
    }
    .navbar-container {
      flex-direction: column;
      align-items: stretch;
    }
    .navbar-brand-container {
      justify-content: space-between;
    }
    .navbar-items-collapse:not(.expanded) {
      display: none;
    }
    .navbar-items-collapsing {
      height: 0;
      overflow: hidden;
      transition: height 350ms ease;
    }
    .navbar-items-container {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-items-collapsing {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('navbar-toggle')
  const container = document.getElementById('navbar-items')

  if (btn && container) {
    btn.addEventListener('click', () => {
      const isOpen = btn.classList.contains('open')
      const animationTimeout = (parseFloat(getComputedStyle(container).transitionDuration) || 0.35) * 1000 + 5

      if (isOpen) {
        container.style.height = container.scrollHeight + 'px'

        container.classList.remove('navbar-items-collapse')
        container.classList.remove('expanded')

        container.classList.add('navbar-items-collapsing')

        container.style.height = ''

        setTimeout(() => {
          container.classList.remove('navbar-items-collapsing')
          container.classList.add('navbar-items-collapse')
          container.classList.remove('expanded')
        }, animationTimeout)
      } else {
        container.classList.remove('navbar-items-collapse')
        container.classList.add('navbar-items-collapsing')

        setTimeout(() => {
          container.classList.remove('navbar-items-collapsing')
          container.classList.add('navbar-items-collapse')
          container.classList.add('expanded')
        }, animationTimeout)

        container.style.height = container.scrollHeight + 'px'
      }

      btn.classList.toggle('open')
      btn.setAttribute('aria-expanded', String(!isOpen))
    })

    document.querySelectorAll('#navbar-items a').forEach((link) => {
      link.addEventListener('click', () => {
        if (btn.classList.contains('open')) btn.click()
      })
    })
  }
</script>
