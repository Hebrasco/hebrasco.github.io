---

import { ButtonType } from 'components/ui/buttons/constants/ButtonType'
import { ButtonVariants } from 'components/ui/buttons/constants/ButtonVariants'

interface Props {
  variant: (typeof ButtonVariants)[keyof typeof ButtonVariants]
  type: (typeof ButtonType)[keyof typeof ButtonType]
  href: string
}

const { variant, href, type } = Astro.props

function getVariantClass(): string {
  switch(variant) {
    case ButtonVariants.filled: return 'button-filled'
    case ButtonVariants.outline: return 'button-outline'
    case ButtonVariants.text: return 'button-text'
  }
}

function getTypeClass(): string {
  switch(type) {
    case ButtonType.primary: return 'button-primary'
    case ButtonType.secondary: return 'button-secondary'
    case ButtonType.text: return 'button-text'
  }
}

---
<a class:list={["button", getVariantClass(), getTypeClass()]} href={href}>
  <slot />
</a>

<style>
  .button {
    padding: 0.6875rem 1.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: var(--border-radius);
    transition-timing-function: ease-in-out;
    transition-duration: 350ms, 350ms, 100ms;
    transition-property: background-color, color, transform;
  }

  .button:active {
    transform: translateY(1px);
  }

  .button:focus-visible {
    outline: 2px solid var(--interactive-color);
    outline-offset: 2px;
  }

  .button-filled {

  }

  .button-outlined {
    border-style: solid;
    border-width: 1.5px;
  }

  .button-outline:hover,
  .button-outline:focus-visible {
    background-color: var(--accent-color);
  }

  .button-text::after {
    content: ' →';
  }

  .button-text:hover {
    color: #0071e3;
    text-decoration: underline;
  }

  .button-primary {
    color: #ffffff;
    background: #1d1d1f;
  }

  .button-outline.button-primary {
    color: var(--primary-text-color);
    border-color: var(--primary-text-color);
  }

  .button-primary:hover {
    color: #ffffff;
    background: #3a3a3c;
  }

  .button-text {
    color: #0071e3;
  }
</style>
