---
import {ButtonVariants} from 'components/ui/buttons/constants/ButtonVariants'

type Variant = (typeof ButtonVariants)[keyof typeof ButtonVariants]

interface Props {
  variant?: Variant
  href: string
  download?: boolean
  target?: string
  icon?: boolean
}

const {
  variant = ButtonVariants.filled,
  href,
  download,
  target,
  icon = false,
} = Astro.props

const variantClass: Record<Variant, string> = {
  filled: 'button button-solid',
  outline: 'button button-outline',
  text: 'button-text',
}

const cls = [variantClass[variant], icon ? 'button-icon' : ''].filter(Boolean).join(' ')
const autoRel = (target === '_blank' ? 'noopener noreferrer' : undefined)
---
<a
  class={cls}
  download={download || undefined}
  href={href}
  rel={autoRel}
  target={target}
>
  <slot />
</a>

<style>
  .button {
    display: inline-block;
    padding: 11px 22px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: 980px;
    transition-timing-function: ease;
    transition-duration: 150ms, 100ms;
    transition-property: background-color, transform;
  }
  .button:hover,
  .button:active,
  .button:focus-visible {
    text-decoration: none;
  }
  .button:focus-visible {
    outline-width: 2px;
    outline-style: solid;
    outline-offset: 2px;
  }
  .button:active {
    transform: translateY(1px);
  }

  .button-solid {
    color: #ffffff;
    background-color: #1d1d1f;
  }
  .button-solid:hover,
  .button-solid:focus-visible {
    color: #ffffff;
    outline-color: #0071e3;
    background-color: #3a3a3c;
  }

  .button-outline {
    color: #1d1d1f;
    background-color: transparent;
    border: 1px solid rgba(0,0,0,0.2);
  }
  .button-outline:hover,
  .button-outline:focus-visible {
    text-decoration: none;
    background-color: rgba(0,0,0,0.04);
  }

  .button-text {
    color: #0071e3;
    text-decoration: none;
  }

  .button-text::after {
    content: ' →';
  }

  .button-text:hover {
    color: #0071e3;
    text-decoration: underline;
  }

  .button-icon {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }
</style>
