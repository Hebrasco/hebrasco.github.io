---
interface Props {
  eyebrow: string
  size?: 'large' | 'medium'
}

const { eyebrow, size = 'large' } = Astro.props
---
<div class="section-header">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class={`title title-${size}`}><slot /></h2>
</div>

<style>
  .eyebrow {
    margin-bottom: 0.375rem;
    font-size: var(--font-size-2extra-small);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    color: var(--label-text-color);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-label);
  }

  .title {
    margin: 0;
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-headings);
    color: var(--primary-text-color);
    letter-spacing: var(--letter-spacing-heading);
  }

  .title-large { font-size: var(--font-size-6extra-large); }

  .title-medium { font-size: var(--font-size-4extra-large); }

  @media (max-width: 700px) {
    .title-medium { font-size: var(--font-size-3extra-large); }
  }

  @media (max-width: 600px) {
    .title-large { font-size: var(--font-size-4extra-large); }
  }
</style>
