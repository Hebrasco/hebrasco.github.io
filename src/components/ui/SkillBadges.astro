---
import Badge from 'components/ui/Badge.astro'
import type { Skill } from 'types'

interface Props {
  skills: readonly Skill[]
}

const { skills } = Astro.props
---
<div class="skill-badges">
  {skills.map(({ name }) => <Badge label={name} />)}
</div>

<style>
  .skill-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
</style>
