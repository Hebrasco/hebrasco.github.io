---
---
<div class="horizontal-list-scroll-container">
  <div class="horizontal-list-container">
    <ul class="horizontal-list-card-set list-unstyled">
      <slot />
    </ul>
  </div>
</div>

<style>
  .horizontal-list-scroll-container {
    position: relative;
    padding: 10px 0;
    margin: -22px 0;
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    scroll-padding: calc(50vw - min(1680px, 87.5vw) / 2);
    scrollbar-width: none;
  }
  .horizontal-list-container {
    --gallery-column-gap: 2rem;
    display: grid;
    grid-template-rows: repeat(1, auto);
    grid-template-columns: max-content;
    grid-auto-flow: column;
    row-gap: 0;
    column-gap: var(--gallery-column-gap);
    width: fit-content;
    margin: 12px 0px;
    overflow: visible;
    scrollbar-width: none;
  }
  .horizontal-list-card-set {
    display: grid;
    grid-template-rows: repeat(1, auto);
    grid-template-columns: max-content;
    grid-auto-flow: column;
    row-gap: 0;
    column-gap: var(--gallery-column-gap);
    width: fit-content;
    padding: 0 calc(50vw - min(1680px, 87.5vw) / 2);
    margin: 0;
    list-style: none;
  }
</style>
