---
import type { Skill } from 'types'
interface Props {
  skill: Skill
}
const { skill } = Astro.props
---
<span class="badge pv-2 ph-3">{skill.name}</span>

<style>
  .badge {
    border-radius: var(--borderRadius);
    font-size: 0.75em;
    white-space: nowrap;
    display: inline-block;
    text-align: center;
    vertical-align: baseline;
    font-weight: 700;
    line-height: 1;
    background-color: var(--accent-color);
  }
</style>
