---

import type { Skill } from 'types'

interface Props {
  skill: Skill
}
const { skill } = Astro.props
---
<span class="badge accent-bg pv-2 ph-3">{skill.name}</span>

<style>
  .badge {
    display: inline-block;
    font-size: 0.75em;
    font-weight: 700;
    line-height: 1;
    vertical-align: baseline;
    text-align: center;
    white-space: nowrap;
    border-radius: var(--border-radius);
  }
</style>
