---
interface Props {
  background?: 'primary' | 'secondary'
  id?: string
  class?: string
}

const { background = 'primary', id, class: className } = Astro.props
---
<section id={id} class:list={['section', background === 'secondary' && 'section-secondary', className]} >
  <slot />
</section>

<style>
  .section {
    padding: var(--space-section) 0;
    background: var(--color-background);
  }

  .section-secondary {
    background: var(--color-background-secondary);
  }

  .section-flush-top {
    padding-top: 0;
  }
</style>
