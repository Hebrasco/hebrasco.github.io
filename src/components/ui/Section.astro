---
interface Props {
  xs?: boolean
  sm?: boolean
  md?: boolean
  lg?: boolean
  xl?: boolean
  anchor?: string
  class?: string
}

const {
  xs = false,
  sm = false,
  md = false,
  lg = false,
  xl = false,
  anchor,
} = Astro.props

const sectionClass = [
  'section',
  xs ? 'section-xs' : '',
  sm ? 'section-sm' : '',
  md ? 'section-md' : '',
  lg ? 'section-lg' : '',
  xl ? 'section-xl' : '',
].filter(Boolean).join(' ')
---
{anchor && <div id={anchor}></div>}
<section class={sectionClass}>
  <slot />
</section>

<style>
  .section {
    margin-right: var(--container-margin);
    margin-left: var(--container-margin);
  }
  .section-xs { padding-top: 1rem; }
  .section-sm { padding-top: 2rem; }
  .section-md { padding-top: 4rem; }
  .section-lg { padding-top: 6rem; }
  .section-xl { padding-top: 12rem; }
</style>
