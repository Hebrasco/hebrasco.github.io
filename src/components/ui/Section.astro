---

interface Props {
  sm?: boolean
  md?: boolean
  lg?: boolean
  anchor?: string
  class?: string
  accent?: boolean
  fullWidth?: boolean
}

const {
  sm = false,
  md = false,
  lg = false,
  anchor,
  accent,
  fullWidth,
  class: className,
} = Astro.props

const sectionClass = [
  fullWidth ? '' : 'section',
  sm ? 'section-sm' : '',
  md ? 'section-md' : '',
  lg ? 'section-lg' : '',
  accent ? 'accent-bg' : '',
  accent && !fullWidth ? 'full-width-accent' : '',
  className
].filter(Boolean).join(' ')
---
{anchor && <div id={anchor}></div>}
<section class={sectionClass}>
  <slot />
</section>

<style>
  .section {
    padding-right: var(--container-margin);
    padding-left: var(--container-margin);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .section-sm {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .section-md {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }
  .section-lg {
    padding-top: 5rem;
    padding-bottom: 5rem;
    }
</style>
