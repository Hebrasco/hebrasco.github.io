---
interface Props {
  sm?: boolean
  md?: boolean
  lg?: boolean
  anchor?: string
  class?: string
  accent?: boolean
  fullWidth?: boolean
}

const {
  sm = false,
  md = false,
  lg = false,
  anchor,
  accent,
  fullWidth
} = Astro.props

const sectionClass = [
  fullWidth ? '' : 'section',
  sm ? 'section-sm' : '',
  md ? 'section-md' : '',
  lg ? 'section-lg' : '',
  accent ? 'accent-bg' : ''
].filter(Boolean).join(' ')
---
{anchor && <div id={anchor}></div>}
<section class={sectionClass}>
  <slot />
</section>

<style>
  .section {
    margin: 0 var(--container-margin);
  }
  .section-sm { padding: 2rem 0; }
  .section-md { padding: 3.5rem 0; }
  .section-lg { padding: 5rem 0; }
</style>
