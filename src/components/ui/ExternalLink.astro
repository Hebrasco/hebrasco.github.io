---
interface Props {
  to: string
  class?: string
  fullWidth?: boolean
  button?: boolean
}
const { to, class: className = '', fullWidth = true, button = false } = Astro.props
const cls = [
  !fullWidth ? 'external-link-icon' : '',
  button ? 'button' : '',
  className,
].filter(Boolean).join(' ')
---
<a href={to} target="_blank" rel="noopener noreferrer" class={cls}>
  <slot />
</a>

<style>
  .external-link-icon {
    width: 2.5rem;
  }
</style>
