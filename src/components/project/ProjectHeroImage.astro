---
import type { Project } from 'types'

interface Props {
  project: Project
}

const { project } = Astro.props
---
<picture class="title-image">
  <source
    srcset={project.titleImage.dark.src}
    media="(prefers-color-scheme: dark)"
  />
  <img
    alt={project.titleImage.altText}
    src={project.titleImage.light.src}
    loading="lazy"
    width="100%"
    height="100%"
  />
</picture>

<style>
  .title-image {
    display: block;
    width: 100%;
  }
  .title-image img {
    width: 100%;
    height: 100%;
  }
</style>
