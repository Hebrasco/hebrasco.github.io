---
import { getImage } from 'astro:assets'
import { BlankAppIcon } from 'assets/images/appIcons'
import Button from 'components/ui/Button.astro'
import { IMAGE_DENSITIES } from 'data/imageDensities'
import { IMAGE_QUALITY } from 'data/imageQuality'
import { getStatusDetail } from 'utils/project'
import { getThemeClass } from 'utils/theme'
import type { Project } from 'types'

interface Props {
  project: Project
}

const { project } = Astro.props

const appIconLight = await getImage({ densities: IMAGE_DENSITIES, quality: IMAGE_QUALITY, src: project.appIcon?.light ?? BlankAppIcon, width: 104 })
const appIconDark = project.appIcon?.dark ? await getImage({ densities: IMAGE_DENSITIES, quality: IMAGE_QUALITY, src: project.appIcon.dark, width: 104 }) : undefined
const header = project.headerImage ? await getImage({ quality: IMAGE_QUALITY, src: project.headerImage.image, widths: [800, 1200, 1600, 2400, 3200, 3840] }) : undefined
const titleLight = header ? undefined : await getImage({ densities: IMAGE_DENSITIES, height: 470, quality: IMAGE_QUALITY, src: project.titleImage.light })
const titleDark = header ? undefined : await getImage({ densities: IMAGE_DENSITIES, height: 470, quality: IMAGE_QUALITY, src: project.titleImage.dark })
---
<div class="wrap project-hero">
  <div class:list={['art', getThemeClass(project), !header && 'stage']}>
    {header && project.headerImage ? (
      <img alt={project.headerImage.altText} class="photo" fetchpriority="high" sizes="(max-width: 640px) 140vw, (max-width: 1200px) 100vw, 1200px" src={header.src} srcset={header.srcSet.attribute} />
    ) : (
      <picture>
        {titleDark && <source media="(prefers-color-scheme: dark)" srcset={titleDark.srcSet.attribute} />}
        <img alt={project.titleImage.altText} class="render" fetchpriority="high" src={titleLight?.src} srcset={titleLight?.srcSet.attribute} />
      </picture>
    )}
  </div>
  <div class="identity">
    <div class="identity-main">
      <picture>
        {appIconDark && <source media="(prefers-color-scheme: dark)" srcset={appIconDark.srcSet.attribute} />}
        <img alt={`${project.name} icon`} class="icon" height="104" src={appIconLight.src} srcset={appIconLight.srcSet.attribute} width="104" />
    </picture>
      <div class="identity-text">
        <h1>{project.name}</h1>
        <p>{project.platforms.join(' · ')} · {getStatusDetail(project)}</p>
      </div>
    </div>
    <div class={`actions ${getThemeClass(project)}`}>
      {project.onlineURL && <Button href={project.onlineURL} icon="bi-apple" target="_blank">App Store</Button>}
      {project.sourceURL && <Button href={project.sourceURL} icon="bi-github" target="_blank" variant="soft">Source code</Button>}
    </div>
  </div>
</div>

<style>
  .project-hero {
    padding-top: var(--space-md);
  }

  .art {
    position: relative;
    height: clamp(15rem, 8rem + 26vw, 32rem);
    overflow: hidden;
    border-radius: var(--radius-tile);
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .render {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: min(92%, 48rem);
    height: 88%;
    object-fit: contain;
    object-position: bottom;
    filter: var(--filter-drop-shadow);
    transform: translateX(-50%);
    will-change: filter;
  }

  .identity {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 var(--space-xl);
    margin-top: -2.25rem;
  }

  .identity-main {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    min-width: 0;
  }

  .identity-main picture {
    flex: none;
  }

  .icon {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: var(--radius-app-icon);
    filter: drop-shadow(0 8px 20px rgb(0 0 0 / 0.18));
    will-change: filter;
  }

  .identity-text {
    padding-top: 2.75rem;
  }

  h1 {
    font-size: var(--text-title-1);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .identity-text p {
    margin-top: 0.25rem;
    font-size: var(--text-callout);
    color: var(--color-text-secondary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-bottom: 0.25rem;
  }

  @media (max-width: 900px) {
    .identity {
      padding: 0 var(--space-md);
    }

    .icon {
      width: 5rem;
      height: 5rem;
    }
  }

  @media (max-width: 640px) {
    .identity {
      padding: 0;
      margin-top: var(--space-lg);
    }

    .identity-text {
      padding-top: 0;
    }
  }
</style>
