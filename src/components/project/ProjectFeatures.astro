---
import HorizontalList from 'components/ui/HorizontalList.astro'
import HorizontalListItem from 'components/ui/HorizontalListItem.astro'
import Section from 'components/ui/Section.astro'
import SectionHeader from 'components/ui/SectionHeader.astro'
import { getThemeClass } from 'utils/theme'
import type { Project } from 'types'

interface Props {
  project: Project
}

const { project } = Astro.props

const highlighted = new Set((project.highlights ?? []).map(({ feature }) => feature))
const features = project.features.filter(({ title }) => !highlighted.has(title))

if (features.length === 0) {
  return
}

const subtitle = `${features.length} ${features.length === 1 ? 'more thing' : 'more things'} it does.`
---
<Section class="section-flush-top">
  <div class="wrap">
    <SectionHeader subtitle={subtitle} title={highlighted.size > 0 ? 'More features.' : 'Features.'} />
  </div>
  <HorizontalList id="features-list" label="Features">
    {features.map((feature) => (
      <HorizontalListItem>
        <div class={`feature ${getThemeClass(project)}`}>
          <i aria-hidden="true" class={feature.icon}></i>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </div>
      </HorizontalListItem>
    ))}
  </HorizontalList>
</Section>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    width: min(80vw, 20rem);
    padding: var(--space-xl);
    color: var(--color-text);
    background: var(--color-background-secondary);
    border-radius: var(--radius-card);
  }

  i {
    font-size: 1.75rem;
    color: var(--color-accent-text);
  }

  h3 {
    margin-top: var(--space-xl);
    font-size: var(--text-title);
    line-height: 1.15;
  }

  p {
    margin-top: var(--space-xs);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
</style>
