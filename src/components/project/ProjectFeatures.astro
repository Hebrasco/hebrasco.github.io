---
import HorizontalList from 'components/ui/HorizontalList.astro'
import ListContainer from 'components/ui/ListContainer.astro'
import Section from 'components/ui/Section.astro'
import type { Project } from 'types'

interface Props {
  project: Project
}

const { project } = Astro.props
---
<Section fluidContainer lg title="Features">
  <HorizontalList>
    {project.features.map((feature) => (
      <ListContainer class="accent-bg rounded">
        <div class="feature-card">
          <div class="feature-content text-muted">
            <p class="text-muted">{feature.title}</p>
            <p class="display-5">{feature.description}</p>
          </div>
        </div>
      </ListContainer>
    ))}
  </HorizontalList>
</Section>

<style>
  .feature-card {
    justify-content: flex-start;
    width: 286px;
    height: 281px;
  }
  .feature-content {
    padding: var(--list-item-padding);
  }
  .feature-content > p {
    margin-bottom: var(--spacings-1);
  }
  .feature-content p {
    font-weight: 600;
  }
  @media (min-width: 576px) {
    .feature-card {
      width: 350px;
      height: 256px;
    }
  }
</style>
