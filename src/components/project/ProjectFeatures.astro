---

import HorizontalList from 'components/ui/HorizontalList.astro'
import ListContainer from 'components/ui/ListContainer.astro'
import Section from 'components/ui/Section.astro'
import SectionHeader from 'components/ui/SectionHeader.astro'
import type { Project } from 'types'

interface Props {
  project: Project
}

const { project } = Astro.props
---
<Section accent fullWidth lg>
  <SectionHeader fullWidth={false} eyebrow='Features'>What it does.</SectionHeader>
  <HorizontalList>
    {project.features.map((feature) => (
      <ListContainer class="rounded">
        <div class="feature-card">
          <div class="feature-icon">
            <i class={feature.icon}></i>
          </div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-description">{feature.description}</p>
        </div>
      </ListContainer>
    ))}
  </HorizontalList>
</Section>

<style>
  .feature-card {
    width: 13.75rem;
    height: 13.75rem;
    padding: 1.375rem;
    scroll-snap-align: start;
    background: var(--primary-color);
    border-radius: 1rem;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.875rem;
    font-size: 1em;
    background: var(--accent-color);
    border-radius: 0.5rem;
  }

  .feature-title {
    margin-bottom: 0.375rem;
    font-size: 0.9375em;
    color: var(--primary-text-color);
  }

  .feature-description {
    font-size: 0.8125rem;
  }
</style>
