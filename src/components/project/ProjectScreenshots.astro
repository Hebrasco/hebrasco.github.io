---
import { getImage } from 'astro:assets'
import HorizontalList from 'components/ui/HorizontalList.astro'
import HorizontalListItem from 'components/ui/HorizontalListItem.astro'
import Section from 'components/ui/Section.astro'
import SectionHeader from 'components/ui/SectionHeader.astro'
import { IMAGE_PIXEL_RATIO } from 'data/imagePixelRatio'
import { IMAGE_QUALITY } from 'data/imageQuality'
import { PLATFORM } from 'data/platform'
import type { Project } from 'types'

interface Props {
  project: Project
}

const { project } = Astro.props

if (!project.screenshots || !Object.values(project.screenshots).some(Boolean)) {
  return
}

type PlatformKey = keyof typeof PLATFORM

const platforms = (Object.keys(project.screenshots) as PlatformKey[]).sort((a, b) =>
  a === 'iphone' ? -1 : b === 'iphone' ? 1 : 0
)

const hasMultiplePlatforms = platforms.length > 1

function getPlatformScreenshotWidth(platform: PlatformKey): number {
  switch (platform) {
    case 'iphone':
      return 261 * IMAGE_PIXEL_RATIO
    case 'ipad':
      return 296 * IMAGE_PIXEL_RATIO
    case 'mac':
    case 'web':
      return 312 * IMAGE_PIXEL_RATIO
  }
}
---
<Section>
  <div class="screenshots-section">
    <div class="screenshots-header">
      <SectionHeader eyebrow="Screenshots" size="medium">See it in action.</SectionHeader>
      {hasMultiplePlatforms && (
        <div class="platform-pills" id="platform-pills">
          {platforms.map((p, i) => (
            <button
              class={`pill ${i === 0 ? 'active' : 'inactive'}`}
              data-platform={p}
              type="button"
            >
              {PLATFORM[p]}
            </button>
          ))}
        </div>
      )}
    </div>
    <div class='screenshots-container'>
      {platforms.map((platform, i) => {
        const screenshots = project.screenshots[platform] ?? []

        return (
          <div
            class="platform-panel"
            data-platform-panel={platform}
            style={i !== 0 ? 'display:none' : ''}
          >
            <HorizontalList>
              {screenshots.map(async (screenshot) => {
                const size = getPlatformScreenshotWidth(platform)
                const screenshotLight = await getImage({ format: 'webp', quality: IMAGE_QUALITY, src: screenshot.light, width: size })
                const screenshotDark = await getImage({ format: 'webp', quality: IMAGE_QUALITY, src: screenshot.dark, width: size })

                return (
                  <HorizontalListItem disableShadow>
                    <picture data-platform-screenshot={platform}>
                      <source media="(prefers-color-scheme: dark)" srcset={screenshotDark.src} />
                      <img
                        alt={screenshot.altText}
                        class="screenshot-image"
                        loading='lazy'
                        src={screenshotLight.src}
                      />
                    </picture>
                  </HorizontalListItem>
                )
              })}
            </HorizontalList>
          </div>
        )
      })}
    </div>
  </div>
</Section>

<style>
  .screenshots-section {
    padding: 4rem 0;
  }

  .screenshots-header {
    display: flex;
    gap: 1rem;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 var(--inset);
    margin-bottom: 1.5rem;
  }

  .platform-pills {
    display: flex;
    flex-shrink: 0;
    gap: 0.375rem;
  }

  .pill {
    all: unset;
    padding: 0.375rem 0.75rem;
    font-size: var(--font-size-2extra-small);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    border-radius: var(--border-radius);
    transition: background-color var(--transition-base);
  }

  .pill.active {
    color: var(--primary-color);
    background-color: var(--primary-text-color);
  }

  .pill.inactive {
    color: var(--sub-text-color);
    background-color: var(--primary-background-color);
  }

  .pill.inactive:hover {
    background-color: var(--hover-surface-color);
  }

  picture[data-platform-screenshot="iphone"] .screenshot-image {
    width: 14.4375rem;
    height: 30rem;
  }

  picture[data-platform-screenshot="ipad"] .screenshot-image {
    width: 23rem;
    height: 30rem;
  }

  picture[data-platform-screenshot="mac"] .screenshot-image {
    width: 44.8125rem;
    height: 30rem;
  }

  @media (max-width: 600px) {
    .screenshots-header {
      flex-direction: column;
      align-items: flex-start;
    }

    picture[data-platform-screenshot="iphone"] .screenshot-image {
      width: 16.3125rem;
      height: 33.875rem;
    }

    picture[data-platform-screenshot="ipad"] .screenshot-image {
      width: 18.5rem;
      height: 24.125rem;
    }

    picture[data-platform-screenshot="mac"] .screenshot-image {
      width: 19.5rem;
    }
  }
</style>

<script>
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      document.querySelectorAll<HTMLElement>('[data-platform-panel]').forEach((panel) => {
        const hscroll = panel.querySelector<HTMLElement>('.hscroll')
        if (hscroll) hscroll.scrollLeft = 0
      })
    }
  })

  const platformPills = document.querySelector('#platform-pills')

  if (platformPills) {
    const pills = platformPills.querySelectorAll<HTMLElement>('.pill')

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const platform = pill.dataset.platform

        pills.forEach((p) => {
          p.classList.toggle('active', p.dataset.platform === platform)
          p.classList.toggle('inactive', p.dataset.platform !== platform)
        })

        document.querySelectorAll<HTMLElement>('[data-platform-panel]').forEach((panel) => {
          panel.style.display = panel.dataset.platformPanel === platform ? '' : 'none'

          const hscroll = panel.querySelector<HTMLElement>('.hscroll')

          if (hscroll) hscroll.scrollLeft = 0
        })
      })
    })
  }
</script>
