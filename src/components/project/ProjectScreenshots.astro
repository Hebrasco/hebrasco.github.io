---
import { getImage } from 'astro:assets'
import HorizontalList from 'components/ui/HorizontalList.astro'
import HorizontalListItem from 'components/ui/HorizontalListItem.astro'
import Section from 'components/ui/Section.astro'
import SectionHeader from 'components/ui/SectionHeader.astro'
import { IMAGE_DENSITIES } from 'data/imageDensities'
import { IMAGE_QUALITY } from 'data/imageQuality'
import { PLATFORM } from 'data/platform'
import type { Project } from 'types'

interface Props {
  project: Project
}

const { project } = Astro.props

type PlatformKey = keyof typeof PLATFORM

const highlightedScreenshots = new Set((project.highlights ?? []).map(({ screenshot }) => screenshot.light.src))

const panels = (Object.keys(project.screenshots) as PlatformKey[])
  .sort((a, b) => (a === 'iphone' ? -1 : b === 'iphone' ? 1 : 0))
  .map((platform) => ({
    platform,
    screenshots: (project.screenshots[platform] ?? []).filter(
      ({ light }) => platform !== 'iphone' || !highlightedScreenshots.has(light.src)
    ),
  }))
  .filter(({ screenshots }) => screenshots.length > 0)

if (panels.length === 0) {
  return
}

function getPlatformScreenshotWidth(platform: PlatformKey): number {
  switch (platform) {
    case 'iphone':
      return 261
    case 'ipad':
      return 368
    case 'mac':
    case 'web':
      return 717
  }
}
---
<Section class="section-flush-top">
  <div class="wrap">
    <SectionHeader title="Screens.">
      {panels.length > 1 && (
        <div class="platform-pills" id="platform-pills">
          {panels.map(({ platform }, index) => (
            <button aria-pressed={index === 0 ? 'true' : 'false'} class="pill" data-platform={platform} type="button">
              {PLATFORM[platform]}
            </button>
          ))}
        </div>
      )}
    </SectionHeader>
  </div>
  {panels.map(({ platform, screenshots }, index) => (
    <div data-platform-panel={platform} style={index !== 0 ? 'display:none' : ''}>
      <HorizontalList id={`screens-${platform}`} label={`${PLATFORM[platform]} screens`}>
        {screenshots.map(async (screenshot) => {
          const width = getPlatformScreenshotWidth(platform)
          const light = await getImage({ densities: IMAGE_DENSITIES, quality: IMAGE_QUALITY, src: screenshot.light, width })
          const dark = await getImage({ densities: IMAGE_DENSITIES, quality: IMAGE_QUALITY, src: screenshot.dark, width })

          return (
            <HorizontalListItem>
              <picture data-platform-screenshot={platform}>
                <source media="(prefers-color-scheme: dark)" srcset={dark.srcSet.attribute} />
                <img alt={screenshot.altText} class="screenshot" height={light.attributes.height} loading="lazy" src={light.src} srcset={light.srcSet.attribute} width={light.attributes.width} />
              </picture>
            </HorizontalListItem>
          )
        })}
      </HorizontalList>
    </div>
  ))}
</Section>

<style>
  .platform-pills {
    display: flex;
    gap: var(--space-xs);
  }

  .pill {
    padding: 0.5rem 1rem;
    font-size: var(--text-callout);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    cursor: pointer;
    background: var(--color-background-secondary);
    border-radius: var(--radius-pill);
    transition: background-color var(--transition-base), color var(--transition-base), transform 120ms ease;
  }

  @media (hover: hover) {
    .pill:hover {
      background: var(--color-pill-surface-hover);
    }
  }

  .pill:active {
    transform: scale(0.97);
  }

  .pill[aria-pressed="true"] {
    color: var(--color-background);
    background: var(--color-text);
  }

  picture[data-platform-screenshot="iphone"] .screenshot {
    width: 14.4375rem;
    height: 30rem;
  }

  picture[data-platform-screenshot="ipad"] .screenshot {
    width: 23rem;
    height: 30rem;
  }

  picture[data-platform-screenshot="mac"] .screenshot,
  picture[data-platform-screenshot="web"] .screenshot {
    width: 44.8125rem;
    height: 30rem;
  }

  @media (max-width: 640px) {
    picture[data-platform-screenshot="iphone"] .screenshot {
      width: 16.3125rem;
      height: 33.875rem;
    }

    picture[data-platform-screenshot="ipad"] .screenshot {
      width: 18.5rem;
      height: 24.125rem;
    }

    picture[data-platform-screenshot="mac"] .screenshot,
    picture[data-platform-screenshot="web"] .screenshot {
      width: 19.5rem;
      height: auto;
    }
  }
</style>

<script>
  const platformPills = document.querySelector('#platform-pills')

  if (platformPills) {
    const pills = platformPills.querySelectorAll<HTMLElement>('.pill')

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const platform = pill.dataset.platform

        pills.forEach((p) => {
          p.setAttribute('aria-pressed', String(p.dataset.platform === platform))
        })

        document.querySelectorAll<HTMLElement>('[data-platform-panel]').forEach((panel) => {
          const isVisible = panel.dataset.platformPanel === platform

          panel.style.display = isVisible ? '' : 'none'

          if (isVisible) panel.querySelector('.shelf')?.dispatchEvent(new Event('scroll'))
        })
      })
    })
  }
</script>
