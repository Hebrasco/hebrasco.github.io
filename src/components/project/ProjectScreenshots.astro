---
import { getImage } from 'astro:assets'
import HorizontalList from 'components/ui/HorizontalList.astro'
import HorizontalListItem from 'components/ui/HorizontalListItem.astro'
import Section from 'components/ui/Section.astro'
import SectionHeader from 'components/ui/SectionHeader.astro'
import { IMAGE_DENSITIES } from 'data/imageDensities'
import { IMAGE_QUALITY } from 'data/imageQuality'
import { PLATFORM } from 'data/platform'
import type { Project } from 'types'

interface Props {
  project: Project
}

const { project } = Astro.props

type PlatformKey = keyof typeof PLATFORM

const panels = (Object.keys(project.screenshots) as PlatformKey[])
  .sort((a, b) => (a === 'iphone' ? -1 : b === 'iphone' ? 1 : 0))
  .map((platform) => ({
    platform,
    screenshots: project.screenshots[platform] ?? [],
  }))
  .filter(({ screenshots }) => screenshots.length > 0)

if (panels.length === 0) {
  return
}

function getPlatformScreenshotWidth(platform: PlatformKey): number {
  switch (platform) {
    case 'iphone':
      return 261
    case 'ipad':
      return 368
    case 'mac':
    case 'web':
      return 717
  }
}
---
<Section class="section-flush-top">
  <div class="wrap">
    <SectionHeader title="Screens.">
      {panels.length > 1 && (
        <div aria-label="Platform" class="platform-pills" id="platform-pills" role="tablist" style={`--count: ${panels.length}`}>
          {panels.map(({ platform }, index) => (
            <button
              aria-controls={`screens-panel-${platform}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              class="pill"
              data-platform={platform}
              id={`screens-tab-${platform}`}
              role="tab"
              tabindex={index === 0 ? '0' : '-1'}
              type="button"
            >
              {PLATFORM[platform]}
            </button>
          ))}
        </div>
      )}
    </SectionHeader>
  </div>
  {panels.map(({ platform, screenshots }, index) => (
    <div
      data-platform-panel={platform}
      hidden={index !== 0}
      id={`screens-panel-${platform}`}
      {...(panels.length > 1 ? { 'aria-labelledby': `screens-tab-${platform}`, role: 'tabpanel' } : {})}
    >
      <HorizontalList id={`screens-${platform}`} label={`${PLATFORM[platform]} screens`}>
        {screenshots.map(async (screenshot) => {
          const width = getPlatformScreenshotWidth(platform)
          const light = await getImage({ densities: IMAGE_DENSITIES, quality: IMAGE_QUALITY, src: screenshot.light, width })
          const dark = await getImage({ densities: IMAGE_DENSITIES, quality: IMAGE_QUALITY, src: screenshot.dark, width })

          return (
            <HorizontalListItem>
              <picture data-platform-screenshot={platform}>
                <source media="(prefers-color-scheme: dark)" srcset={dark.srcSet.attribute} />
                <img alt={screenshot.altText} class="screenshot" height={light.attributes.height} loading="lazy" src={light.src} srcset={light.srcSet.attribute} width={light.attributes.width} />
              </picture>
            </HorizontalListItem>
          )
        })}
      </HorizontalList>
    </div>
  ))}
</Section>

<style>
  .platform-pills {
    --segment-inset: 0.1875rem;
    position: relative;
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    padding: var(--segment-inset);
    background: var(--color-background-secondary);
    border-radius: var(--radius-pill);
    isolation: isolate;
  }

  .platform-pills::before {
    position: absolute;
    top: var(--segment-inset);
    bottom: var(--segment-inset);
    left: var(--segment-inset);
    z-index: -1;
    width: calc((100% - 2 * var(--segment-inset)) / var(--count));
    content: "";
    background: light-dark(#ffffff, #3a3a3c);
    border-radius: var(--radius-pill);
    box-shadow: 0 1px 4px light-dark(rgb(0 0 0 / 0.12), transparent);
    transition: translate 350ms var(--ease);
  }

  .platform-pills:has(.pill:nth-child(2)[aria-selected="true"])::before {
    translate: 100% 0;
  }

  .platform-pills:has(.pill:nth-child(3)[aria-selected="true"])::before {
    translate: 200% 0;
  }

  .platform-pills:has(.pill:nth-child(4)[aria-selected="true"])::before {
    translate: 300% 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .platform-pills::before {
      transition: none;
    }
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    font-size: var(--text-callout);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    cursor: pointer;
    border-radius: var(--radius-pill);
    transition: color var(--transition-base), transform 120ms ease;
  }

  @media (hover: hover) {
    .pill:hover {
      color: var(--color-text);
    }
  }

  .pill:active {
    transform: scale(0.97);
  }

  .pill[aria-selected="true"] {
    color: var(--color-text);
  }

  .screenshot {
    filter: var(--filter-drop-shadow);
    will-change: filter;
  }

  picture[data-platform-screenshot="iphone"] .screenshot {
    width: 14.4375rem;
    height: 30rem;
  }

  picture[data-platform-screenshot="ipad"] .screenshot {
    width: 23rem;
    height: 30rem;
  }

  picture[data-platform-screenshot="mac"] .screenshot,
  picture[data-platform-screenshot="web"] .screenshot {
    width: 44.8125rem;
    height: 30rem;
  }

  @media (max-width: 640px) {
    picture[data-platform-screenshot="iphone"] .screenshot {
      width: 16.3125rem;
      height: 33.875rem;
    }

    picture[data-platform-screenshot="ipad"] .screenshot {
      width: 18.5rem;
      height: 24.125rem;
    }

    picture[data-platform-screenshot="mac"] .screenshot,
    picture[data-platform-screenshot="web"] .screenshot {
      width: 19.5rem;
      height: auto;
    }
  }
</style>

<script>
  const platformPills = document.querySelector('#platform-pills')

  if (platformPills) {
    const pills = Array.from(platformPills.querySelectorAll<HTMLElement>('.pill'))

    const select = (pill: HTMLElement) => {
      const platform = pill.dataset.platform

      pills.forEach((p) => {
        const isSelected = p === pill

        p.setAttribute('aria-selected', String(isSelected))
        p.tabIndex = isSelected ? 0 : -1
      })

      document.querySelectorAll<HTMLElement>('[data-platform-panel]').forEach((panel) => {
        const isVisible = panel.dataset.platformPanel === platform

        panel.hidden = !isVisible

        if (isVisible) panel.querySelector('.shelf')?.dispatchEvent(new Event('scroll'))
      })
    }

    pills.forEach((pill, index) => {
      pill.addEventListener('click', () => select(pill))

      pill.addEventListener('keydown', (event) => {
        const offsets: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1 }
        const targets: Record<string, number> = { End: pills.length - 1, Home: 0 }
        const key = event.key
        const next =
          key in offsets
            ? (index + (offsets[key] ?? 0) + pills.length) % pills.length
            : targets[key]

        if (next === undefined) return

        event.preventDefault()

        const target = pills[next]

        if (!target) return

        select(target)
        target.focus()
      })
    })
  }
</script>
