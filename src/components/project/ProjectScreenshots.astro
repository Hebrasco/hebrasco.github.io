---















import HorizontalList from 'components/ui/HorizontalList.astro'
import ListContainer from 'components/ui/ListContainer.astro'
import Section from 'components/ui/Section.astro'
import SectionHeader from 'components/ui/SectionHeader.astro'
import { SCREENSHOT_CONTAINER_SIZE } from 'data/containerSizes'
import { PLATFORM } from 'data/platform'
import type { Project } from 'types'

interface Props {
  project: Project
}

const { project } = Astro.props

if (!project.screenshots || !Object.values(project.screenshots).some(Boolean)) {
  return
}

type PlatformKey = keyof typeof PLATFORM
const platforms = (Object.keys(project.screenshots) as PlatformKey[]).sort((a) =>
  a === 'iphone' ? -1 : 1
)
const hasMultiplePlatforms = platforms.length > 1
---
<Section fullWidth lg>
  <div class="screenshots-header">
    <SectionHeader fullWidth={false} eyebrow='Screenshots'>See it in action.</SectionHeader>
    {hasMultiplePlatforms && (
      <div class="platform-pills" id="platform-pills">
        {platforms.map((p, i) => (
          <button
            class={`pill ${i === 0 ? 'active' : 'inactive'}`}
            data-platform={p}
            type="button"
          >
            {PLATFORM[p]}
          </button>
        ))}
      </div>
    )}
  </div>
  {platforms.map((platform, index) => {
    return (
      <div
        data-platform-group={platform}
        hidden={index !== 0}
      >
        <HorizontalList>
          {platforms.map((platform, i) => {
            const screenshots = project.screenshots[platform] ?? []
            return screenshots.map((screenshot) => {
              const screenshotLight = screenshot.light
              const screenshotDark = screenshot.dark

              return (
               <ListContainer>
                 <picture
                    data-platform-shot={platform}
                    style={i !== 0 ? 'display:none' : ''}
                  >
                    {screenshotDark && (
                      <source media="(prefers-color-scheme: dark)" srcset={screenshotDark.src} />
                    )}
                    <img
                      alt={screenshot.altText}
                      class="screenshot-image"
                      height={SCREENSHOT_CONTAINER_SIZE[platform].md.height}
                      loading="lazy"
                      src={screenshotLight.src}
                      width={SCREENSHOT_CONTAINER_SIZE[platform].md.width}
                    />
                  </picture>
               </ListContainer>
              )
            })
          })}
        </HorizontalList>
      </div>
    )
  })}
</Section>

<style>
  .select-container {
    position: relative;
  }
  .dropdown-button {
    all: unset;
    cursor: pointer;
  }
  .dropdown-button > .bi-chevron-down::before {
    transition: transform 250ms ease-in-out;
  }
  .dropdown-button.open > .bi-chevron-down::before {
    transform: rotate(180deg);
  }
  .select-menu {
    --select-item-padding: 1rem;
    --select-item-icon-font-size: 1em;
    --select-item-icon-margin: 0.5rem;
    position: absolute;
    top: 125%;
    right: -1.25rem;
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    background-color: var(--primary-color);
    border: 2px solid var(--accent-color);
    border-radius: 22px;
  }
  .select-menu[hidden] {
    display: none;
  }
  .select-menu-arrow {
    position: absolute;
    top: -1.25rem;
    right: 1rem;
    z-index: -100;
    border-top: 10px solid transparent;
    border-right: 10px solid transparent;
    border-bottom: 10px solid var(--accent-color);
    border-left: 10px solid transparent;
  }
  .select-menu > p,
  .select-item {
    padding: calc(var(--select-item-padding) / 2) var(--select-item-padding);
  }
  .select-item {
    all: unset;
    display: flex;
    padding: calc(var(--select-item-padding) / 2) var(--select-item-padding);
    padding-right: calc(var(--select-item-padding) + var(--select-item-icon-font-size) + var(--select-item-icon-margin));
    cursor: pointer;
    border-radius: 0.75rem;
  }
  .select-item:hover,
  .select-item:focus-visible {
    background-color: var(--accent-color);
  }
  .select-item > i {
    margin-right: var(--select-item-icon-margin);
    font-size: var(--select-item-icon-font-size);
  }
  .screenshot-img {
    width: var(--w-xs);
    height: var(--h-xs);
  }

  .screenshots-header {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-right: var(--container-margin);
    margin-bottom: 1.5rem;
  }

  .platform-pills {
    display: flex;
    flex-shrink: 0;
    gap: 0.375rem;
  }

  .pill {
    all: unset;
    padding: 0.375rem 0.75rem;
    cursor: pointer;
    border-radius: var(--border-radius);
    transition: background-color var(--transition-base);
  }

  .pill.active {
    color: var(--primary-color);
    background: var(--primary-text-color);
  }

  .pill.inactive {
    color: var(--secondary-color);
    background: var(--secondary-background-color);
  }

  .pill.inactive:hover {
    background: var(--accent-color);
  }

  @media (min-width: 576px) {
    .screenshot-img {
      width: var(--w-md);
      height: var(--h-md);
    }
  }
</style>

{hasMultiplePlatforms && (
  <script>
    const pills = document.querySelectorAll<HTMLDivElement>('#platform-pills .pill')
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const platform = pill.dataset.platform
        const scroll = document.getElementById('screenshots-scroll')
        if (scroll) scroll.scrollLeft = 0
        pills.forEach((p) => {
          p.classList.toggle('active', (p as HTMLElement).dataset.platform === platform)
          p.classList.toggle('inactive', (p as HTMLElement).dataset.platform !== platform)
        })
        document.querySelectorAll('[data-platform-shot]').forEach((img) => {
          (img as HTMLElement).style.display =
            (img as HTMLElement).dataset.platformShot === platform ? '' : 'none'
        })
      })
    })
  </script>
)}
