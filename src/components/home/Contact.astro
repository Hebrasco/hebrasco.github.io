---
import Column from 'components/layout/Column.astro'
import Row from 'components/layout/Row.astro'
import ButtonLink from 'components/ui/buttons/ButtonLink.astro'
import { ButtonVariants } from 'components/ui/buttons/constants/ButtonVariants'
import Section from 'components/ui/Section.astro'
import SectionHeader from 'components/ui/SectionHeader.astro'
import { CONFIG, ROUTES } from 'data'
---
<Section anchor={ROUTES.contact} md>
  <div class='contact-inner'>
    <SectionHeader eyebrow='Contact'>Get in touch.</SectionHeader>
    <Row>
      <Column class='mb-3'>
        <p>Interested in working together or just want to say hello?</p>
      </Column>
      <Column>
        <ButtonLink href={CONFIG.profile.email} variant={ButtonVariants.outline}>{CONFIG.profile.email}</ButtonLink>
      </Column>
      <Column>
        <ButtonLink href={CONFIG.references.gitHubUrl} variant={ButtonVariants.chip} target='_blank'>GitHub</ButtonLink>
        <ButtonLink href={CONFIG.references.appStoreUrl} variant={ButtonVariants.chip} target='_blank'>App Store</ButtonLink>
        <ButtonLink href={'/daniel_bedrich_resume.pdf'} variant={ButtonVariants.chip} download>Download Resume</ButtonLink>
      </Column>
    </Row>
  </div>
</Section>

<style>
  .contact-inner {
    text-align: center;
  }
</style>
