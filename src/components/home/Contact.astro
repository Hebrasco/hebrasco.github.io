---
import Button from 'components/ui/Button.astro'
import Section from 'components/ui/Section.astro'
import { CONFIG } from 'data'
---
<Section background="secondary" id="contact">
  <div class="wrap contact">
    <h2>Get in touch.</h2>
    <p>Interested in working together or just want to say hello?</p>
    <Button href={`mailto:${CONFIG.profile.email}`} icon="bi-envelope">{CONFIG.profile.email}</Button>
    <div class="links">
      <Button href={CONFIG.references.gitHubUrl} icon="bi-github" target="_blank" variant="neutral">GitHub</Button>
      <Button href={CONFIG.references.appStoreUrl} icon="bi-app-indicator" target="_blank" variant="neutral">App Store</Button>
      <Button download href="/daniel_bedrich_resume.pdf" icon="bi-file-earmark-text" variant="neutral">Resume</Button>
    </div>
  </div>
</Section>

<style>
  .contact {
    text-align: center;
  }

  h2 {
    font-size: var(--text-section);
    line-height: 1.1;
  }

  p {
    max-width: 30rem;
    margin: var(--space-sm) auto var(--space-xl);
    font-size: var(--text-title);
    color: var(--color-text-secondary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-top: var(--space-lg);
  }
</style>
