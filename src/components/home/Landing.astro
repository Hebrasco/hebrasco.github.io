---
import { CONFIG, ROUTES } from 'data'
const firstName = CONFIG.profile.name.split(' ')[0]
---
<div class="landing-container">
  <div class="landing-title-container">
    <div>
      <div class="landing-title">
        <h1>Hi, I am</h1>
        <h1>{firstName}</h1>
        <p>{CONFIG.profile.jobTitle}</p>
      </div>
    </div>
  </div>
  <div class="landing-image"></div>
  <div class="scroll-down-icon-container">
    <a href={ROUTES.aboutMe} class="scroll-down-btn">
      <span class="sr-only">Scroll to about me</span>
      <div class="scroll-down-icon shadow">
        <i class="bi bi-chevron-down"></i>
      </div>
    </a>
  </div>
</div>

<style>
  .landing-container {
    height: 100vh;
    width: 100vw;
  }

  .landing-title-container {
    width: 69%;
    margin: 0 auto;
  }
  .landing-title-container > div {
    position: absolute;
    display: flex;
    align-items: center;
    height: 100%;
  }
  .landing-title > h1 {
    font-size: var(--titleFontSize);
    font-weight: 700;
    margin: 0;
    line-height: 1.07;
    letter-spacing: -0.5px;
  }
  .landing-title > p {
    font-size: var(--subTitleFontSize);
    font-weight: 600;
    margin: 0;
    margin-left: 1.25%;
    margin-top: 1.5rem;
    line-height: max(2rem, 5vmin);
    width: max-content;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .landing-title > h1:nth-child(1) { animation: fadeInUp 0.9s cubic-bezier(0.25, 1, 0.5, 1) both; }
  .landing-title > h1:nth-child(2) { animation: fadeInUp 0.9s cubic-bezier(0.25, 1, 0.5, 1) 0.12s both; }
  .landing-title > p               { animation: fadeInUp 0.9s cubic-bezier(0.25, 1, 0.5, 1) 0.24s both; }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .landing-image {
    background-image: url("../../assets/images/me.webp");
    background-repeat: no-repeat;
    background-size: cover;
    z-index: -1;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 40%;
    animation: fadeIn 1.2s cubic-bezier(0.25, 1, 0.5, 1) 0.1s both;
  }

  .scroll-down-icon-container {
    position: absolute;
    right: 0;
    bottom: 1rem;
    left: 0;
    display: flex;
    justify-content: center;
  }
  .scroll-down-btn {
    display: block;
  }
  .scroll-down-icon {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    animation: down 2s 1.5s infinite;
    backdrop-filter: blur(var(--glassBlur));
    background-color: var(--glassBackground);
    border: 2px solid var(--glassBorder);
  }
  .scroll-down-icon > i {
    font-size: 2rem;
    height: 2.15rem;
  }

  @keyframes down {
    0%       { transform: translateY(0); animation-timing-function: cubic-bezier(0.5, 0, 1, 0.5); }
    20%      { transform: translateY(0.75rem); animation-timing-function: cubic-bezier(0, 0.5, 0.5, 1); }
    40%, 100% { transform: translateY(0); }
  }

  @media (max-width: 575px) {
    .landing-title-container { width: 90%; }
    .landing-image { left: 2%; }
  }
  @media (min-width: 576px) and (max-width: 767px) {
    .landing-image { left: 20%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-title > h1,
    .landing-title > p,
    .landing-image,
    .scroll-down-icon { animation: none; }
  }
</style>
