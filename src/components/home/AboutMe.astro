---
import Column from 'components/layout/Column.astro'
import Row from 'components/layout/Row.astro'
import ButtonLink from 'components/ui/buttons/ButtonLink.astro'
import { ButtonVariants } from 'components/ui/buttons/constants/ButtonVariants'
import KeyInfoTitle from 'components/ui/KeyInfoTitle.astro'
import Badge from 'components/ui/Badge.astro'
import Section from 'components/ui/Section.astro'
import SectionHeader from 'components/ui/SectionHeader.astro'
import { CONFIG, PROFILE, ROUTES } from 'data'
import SkillBadges from 'components/ui/SkillBadges.astro'

const { profile } = CONFIG
---
<Section anchor={ROUTES.aboutMe} lg>
  <SectionHeader eyebrow='About'>Building apps<br />people actually use.</SectionHeader>
  <Row  gap={2.25}>
    <Column md={5} sm={10} xs={12}>
      <p>
        I've been building for the web for over ten years, not because I fell into it, but because I actually love the work.
        I care about alle the little details and write code I'm not embarrassed to look at later. I've shipped production apps used by hundreds
        of thousands of users and I keep a growing collection of personal project going on the side, mostly because I can't stop
        coming up with things to build.
      </p>
    </Column>
    <Column class="d-flex align-items-center gap-3" xs={12}>
      <ButtonLink variant={ButtonVariants.filled} href={"/daniel_bedrich_resume.pdf"} download>Download Resume</ButtonLink>
      <ButtonLink variant={ButtonVariants.outline} href={`mailto:${profile.email}`}>Let's Talk</ButtonLink>
    </Column>
      <Column class="skills-column" md={4} xs={12}>
        <KeyInfoTitle title="Languages" />
        <SkillBadges skills={PROFILE.skills.languages} />
      </Column>
      <Column class="skills-column" md={4} xs={12}>
        <KeyInfoTitle title="Frameworks" />
        <SkillBadges skills={PROFILE.skills.frameworks} />
      </Column>
      <Column class="skills-column" md={4} xs={12}>
        <KeyInfoTitle title="Applications" />
        <SkillBadges skills={PROFILE.skills.applications} />
      </Column>
  </Row>
</Section>

<style>
  .skills-column > :global(div) {
    width: 100%;
  }
</style>
