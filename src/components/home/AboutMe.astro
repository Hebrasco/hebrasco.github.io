---
import Button from 'components/ui/Button.astro'
import Section from 'components/ui/Section.astro'
import SkillBadges from 'components/ui/SkillBadges.astro'
import { CONFIG, PROFILE } from 'data'

const skillGroups = [
  { skills: PROFILE.skills.languages, title: 'Languages' },
  { skills: PROFILE.skills.frameworks, title: 'Frameworks' },
  { skills: PROFILE.skills.applications, title: 'Tools' },
]
---
<Section id="about-me">
  <div class="wrap about-grid">
    <div class="about-text">
      <h2>About me. <span>Building apps people actually love.</span></h2>
      <p>
        I'm an {CONFIG.profile.jobTitle} with <strong>over ten years of experience</strong> turning ideas into products people love to use. I think about structure and long-term decisions early, so the projects I build can grow without needing to be rebuilt. The apps I've built have reached <strong>hundreds of thousands of users</strong>, and I'm proud of every one of them.
      </p>
      <div class="actions">
        <Button download href="/daniel_bedrich_resume.pdf" icon="bi-download" variant="soft">Download resume</Button>
      </div>
    </div>
    <div class="skill-groups">
      {skillGroups.map(({ title, skills }) => (
        <div>
          <h3>{title}</h3>
          <SkillBadges skills={skills} />
        </div>
      ))}
    </div>
  </div>
</Section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  h2 {
    margin-bottom: var(--space-md);
    font-size: var(--text-section);
    line-height: var(--line-height-tight);
  }

  h2 span {
    color: var(--color-text-secondary);
  }

  .about-text p {
    font-size: var(--text-title);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .about-text strong {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .actions {
    margin-top: var(--space-xl);
  }

  .skill-groups {
    display: grid;
    gap: var(--space-xl);
    padding-top: 0.4rem;
  }

  h3 {
    margin-bottom: var(--space-sm);
    font-size: var(--text-body);
  }

  .skill-groups :global(.badge) {
    padding: 0.35rem 0.75rem;
    font-size: var(--text-callout);
  }

  .skill-groups :global(.skill-badges) {
    --color-badge-background: var(--color-background-secondary);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
