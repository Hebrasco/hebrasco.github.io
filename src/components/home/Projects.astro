---
import { getImage } from 'astro:assets'
import HorizontalList from 'components/ui/HorizontalList.astro'
import HorizontalListItem from 'components/ui/HorizontalListItem.astro'
import Section from 'components/ui/Section.astro'
import SectionHeader from 'components/ui/SectionHeader.astro'
import SkillBadges from 'components/ui/SkillBadges.astro'
import { PROJECTS, ROUTES } from 'data'
import { IMAGE_DENSITIES } from 'data/imageDensities'
import { IMAGE_QUALITY } from 'data/imageQuality'
import { getStatusSummary } from 'utils/project'
import { getThemeClass } from 'utils/theme'
---
<Section background="secondary" id="projects">
  <div class="wrap">
    <SectionHeader subtitle="Apps I designed and built myself." title="Projects." />
  </div>
  <HorizontalList id="projects-list" label="Projects">
    {PROJECTS.map(async (project) => {
      const titleLight = await getImage({ densities: IMAGE_DENSITIES, quality: IMAGE_QUALITY, src: project.titleImage.light, width: 336 })
      const titleDark = await getImage({ densities: IMAGE_DENSITIES, quality: IMAGE_QUALITY, src: project.titleImage.dark, width: 336 })

      return (
        <HorizontalListItem>
          <a class={`project-card ${getThemeClass(project)}`} href={ROUTES.project.replace(':projectId', project.id)}>
            <div class="project-text">
              <span class="project-status">{getStatusSummary(project)}</span>
              <h3>{project.name}</h3>
              <p>{project.summaryHeading}</p>
              <SkillBadges skills={[...project.languages, ...project.frameworks]} />
            </div>
            <div class="project-art">
              <picture>
                <source media="(prefers-color-scheme: dark)" srcset={titleDark.srcSet.attribute} />
                <img alt={project.titleImage.altText} loading="lazy" src={titleLight.src} srcset={titleLight.srcSet.attribute} />
              </picture>
            </div>
          </a>
        </HorizontalListItem>
      )
    })}
  </HorizontalList>
</Section>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    width: min(82vw, 24rem);
    height: 33rem;
    overflow: hidden;
    color: var(--color-text);
    background: var(--color-background);
    border-radius: var(--radius-card);
    box-shadow: 2px 4px 12px var(--color-card-shadow);
    transition: transform 450ms var(--ease), box-shadow 450ms var(--ease);
  }

  .project-card:hover {
    box-shadow: 2px 8px 24px var(--color-card-shadow-hover);
    transform: translateY(-4px);
  }

  .project-text {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-xl) var(--space-xl) 0;
  }

  .project-status {
    margin-bottom: 0.25rem;
    font-size: var(--text-callout);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-text);
  }

  h3 {
    font-size: var(--text-title-1);
    line-height: 1.05;
  }

  p {
    color: var(--color-text-secondary);
  }

  .project-text :global(.skill-badges) {
    --color-badge-background: light-dark(color-mix(in oklab, var(--color-accent) 12%, transparent), color-mix(in oklab, var(--color-accent) 18%, transparent));
    margin-top: var(--space-sm);
  }

  .project-art {
    display: flex;
    flex: 1;
    align-items: flex-end;
    justify-content: center;
    min-height: 0;
    padding: var(--space-lg);
  }

  .project-art picture {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .project-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    filter: var(--filter-drop-shadow);
    will-change: filter;
  }

  @media (max-width: 640px) {
    .project-card {
      height: 30rem;
    }
  }
</style>
