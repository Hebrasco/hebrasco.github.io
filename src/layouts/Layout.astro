---
import 'assets/styles/colors.css'
import 'assets/styles/typography.css'
import 'assets/styles/reset.css'
import Footer from 'components/layout/Footer.astro'
import NavBar from 'components/layout/NavBar.astro'
import { CONFIG } from 'data'

interface Props {
  title: string
  description: string
  image?: string
  indexable?: boolean
}

const {
  title,
  description,
  image = '/icon-512.png',
  indexable = true
} = Astro.props

const imageUrl = new URL(image, Astro.site).href
const canonicalPath = Astro.url.pathname.replace(/(index)?\.html$/, '')
const canonicalUrl = new URL(canonicalPath, Astro.site).href
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="application-name" content="Daniel Bedrich" />
    <meta property="og:site_name" content={`${CONFIG.profile.name} - ${CONFIG.profile.jobTitle}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    {indexable ? <link href={canonicalUrl} rel="canonical" /> : <meta content="noindex" name="robots" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <NavBar />
    <slot />
    <Footer />
  </body>
</html>

<style>
  body {
    padding-top: 3rem;
  }
</style>

<!--
Fix for deprecated hash urls of pre v4.0.0 portfolio
Still used as privacy policy urls for App Store
Remove once all apps have received updates
-->
<script>
  if (window.location.hash === '#/imprint') {
    window.location.replace('/imprint');
  }
</script>
