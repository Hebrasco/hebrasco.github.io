---
import 'bootstrap-icons/font/bootstrap-icons.css'
import 'assets/styles/reset.css'
import 'assets/styles/colors.css'
import 'assets/styles/typography.css'
import 'assets/styles/layout.css'
import 'assets/styles/shape.css'
import 'assets/styles/motion.css'
import Footer from 'components/layout/Footer.astro'
import NavBar from 'components/layout/NavBar.astro'
import { CONFIG, PROJECTS } from 'data'
import { getProjectThemesCss } from 'utils/theme'

interface Props {
  title: string
  description: string
  image?: string
  indexable?: boolean
}

const {
  title,
  description,
  image = '/icon-512.png',
  indexable = true
} = Astro.props

const imageUrl = new URL(image, Astro.site).href
const canonicalPath = Astro.url.pathname.replace(/(index)?\.html$/, '')
const canonicalUrl = new URL(canonicalPath, Astro.site).href
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content={description} name="description" />
    <meta content="Daniel Bedrich" name="application-name" />
    <meta content={`${CONFIG.profile.name} - ${CONFIG.profile.jobTitle}`} property="og:site_name" />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={imageUrl} property="og:image" />
    <meta content={canonicalUrl} property="og:url" />
    {indexable ? <link href={canonicalUrl} rel="canonical" /> : <meta content="noindex" name="robots" />}
    <meta content="light dark" name="color-scheme" />
    <meta content="#ffffff" media="(prefers-color-scheme: light)" name="theme-color" />
    <meta content="#000000" media="(prefers-color-scheme: dark)" name="theme-color" />
    <link href="/favicon.ico" rel="icon" />
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/manifest.json" rel="manifest" />
    <title>{title}</title>
    <style is:inline set:html={getProjectThemesCss(PROJECTS)} />
    <slot name="head" />
  </head>
  <body>
    <NavBar />
    <slot />
    <Footer />
  </body>
</html>

<style>
  body {
    padding-top: var(--nav-height);
  }
</style>
